@model CadastroAlunos.Models.Aluno

@{
    ViewData["Title"] = "Cadastro Realizado!";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
        }
        .card {
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }
        .card-header {
            background-color: #198754;
            color: white;
            border-radius: 12px 12px 0 0 !important;
        }
        .info-label {
            font-size: 0.85rem;
            color: #6c757d;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .info-value {
            font-size: 1rem;
            color: #212529;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-7">

                <!-- Mensagem de sucesso -->
                <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                    <span class="me-2" style="font-size: 1.4rem;">✅</span>
                    <div>
                        <strong>Cadastro realizado com sucesso!</strong><br />
                        Os dados do aluno foram registrados corretamente.
                    </div>
                </div>

                <div class="card">
                    <div class="card-header py-3">
                        <h5 class="mb-0">📋 Dados Cadastrados</h5>
                    </div>
                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-12">
                                <p class="info-label mb-0">Nome Completo</p>
                                <p class="info-value">@Model.Nome</p>
                            </div>

                            <div class="col-12">
                                <hr class="my-0" />
                            </div>

                            <div class="col-sm-6">
                                <p class="info-label mb-0">E-mail</p>
                                <p class="info-value">@Model.Email</p>
                            </div>

                            <div class="col-sm-6">
                                <p class="info-label mb-0">RA</p>
                                <p class="info-value">@Model.RA</p>
                            </div>

                            <div class="col-12">
                                <hr class="my-0" />
                            </div>

                            <div class="col-sm-6">
                                <p class="info-label mb-0">Curso</p>
                                <p class="info-value">@Model.Curso</p>
                            </div>

                            <div class="col-sm-6">
                                <p class="info-label mb-0">Data de Nascimento</p>
                                <p class="info-value">@Model.DataNascimento.ToString("dd/MM/yyyy")</p>
                            </div>

                        </div>

                    </div>
                    <div class="card-footer bg-white border-top-0 p-4 pt-0">
                        <!-- Botão para voltar ao formulário -->
                        <a asp-action="Cadastrar" asp-controller="Aluno" class="btn btn-outline-primary w-100">
                            ➕ Cadastrar outro aluno
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</body>
</html>
